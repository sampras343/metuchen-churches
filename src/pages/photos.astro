---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Photos & Flyers — Most Holy Name of Jesus Parish</title>
  <link rel="icon" href={`${base}favicon.ico`} />
  <link rel="preconnect" href="https://api.fontshare.com" />
  <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
  <link href="https://api.fontshare.com/v2/css?f[]=chillax@400,500,600&display=swap" rel="stylesheet" />
</head>
<body data-base={base}>

  <!-- NAV -->
  <nav class="fixed top-0 left-0 w-full z-50 flex items-center justify-between h-16" style="padding: 0 var(--margin); background: rgba(252,249,242,0.95);">
    <a href={base} class="flex items-center gap-2" style="color: var(--accent); font-size: var(--step-small); font-weight: 600; letter-spacing: -0.02em; text-decoration: none;">
      <img src={`${base}favicon.ico`} alt="" width="24" height="24" style="flex-shrink: 0;" />
      <span data-lang="en">Most Holy Name of Jesus</span>
      <span data-lang="es">Santísimo Nombre de Jesús</span>
    </a>
    <div class="hidden md:flex items-center gap-6">
      <a href={base} style="font-size: var(--step-small); color: var(--muted);">
        <span data-lang="en">Home</span><span data-lang="es">Inicio</span>
      </a>
      <a href={`${base}photos`} style="font-size: var(--step-small); color: var(--accent); font-weight: 600;">
        <span data-lang="en">Photos</span><span data-lang="es">Fotos</span>
      </a>
      <button id="lang-toggle" class="btn" style="padding: 6px 16px; font-size: var(--step-small);" aria-label="Switch language">ES</button>
    </div>
    <div class="flex md:hidden items-center gap-3">
      <button id="lang-toggle-mobile" class="btn" style="padding: 4px 12px; font-size: var(--step-small);" aria-label="Switch language">ES</button>
      <a href={base} style="font-size: var(--step-small); color: var(--muted); text-decoration: none;">
        <span data-lang="en">Home</span><span data-lang="es">Inicio</span>
      </a>
    </div>
  </nav>

  <!-- HERO -->
  <section style="padding: 100px var(--margin) 40px; background: var(--surface);">
    <h1 class="font-semibold" style="font-size: var(--step-head); letter-spacing: -0.03em; color: var(--cream);">
      <span data-lang="en">Photos & Flyers</span>
      <span data-lang="es">Fotos y Volantes</span>
    </h1>
    <p style="margin-top: 8px; color: var(--sky);">
      <span data-lang="en">Parish life in pictures</span>
      <span data-lang="es">La vida parroquial en imágenes</span>
    </p>

    <!-- Tab switcher -->
    <div class="flex gap-4" style="margin-top: 32px;">
      <button id="tab-flyers" class="photo-tab active" style="padding: 10px 24px; font-size: var(--step-small); font-weight: 600; font-family: inherit; border: none; cursor: pointer; background: var(--accent); color: var(--accent-ink);">
        <span data-lang="en">Flyers</span><span data-lang="es">Volantes</span>
      </button>
      <button id="tab-albums" class="photo-tab" style="padding: 10px 24px; font-size: var(--step-small); font-weight: 600; font-family: inherit; border: none; cursor: pointer; background: rgba(252,249,242,0.1); color: var(--sky);">
        <span data-lang="en">Photo Albums</span><span data-lang="es">Álbumes de Fotos</span>
      </button>
    </div>
  </section>

  <!-- FLYERS SECTION -->
  <section id="flyers-section" style="padding: clamp(40px, 6vw, 80px) var(--margin);">
    <h2 class="font-semibold" style="font-size: var(--step-head); letter-spacing: -0.03em; color: var(--ink);">
      <span data-lang="en">This Week</span>
      <span data-lang="es">Esta Semana</span>
    </h2>
    <div id="flyers-current" style="margin-top: 24px;">
      <p style="color: var(--muted);">
        <span data-lang="en">Loading...</span>
        <span data-lang="es">Cargando...</span>
      </p>
    </div>

    <h2 class="font-semibold" style="font-size: var(--step-lead); letter-spacing: -0.02em; color: var(--ink); margin-top: 64px;">
      <span data-lang="en">Flyer Archive</span>
      <span data-lang="es">Archivo de Volantes</span>
    </h2>
    <div id="flyers-archive" style="margin-top: 24px;">
      <p style="color: var(--muted);">
        <span data-lang="en">Loading...</span>
        <span data-lang="es">Cargando...</span>
      </p>
    </div>
  </section>

  <!-- PHOTO ALBUMS SECTION -->
  <section id="albums-section" style="padding: clamp(40px, 6vw, 80px) var(--margin); display: none;">
    <div id="albums-container">
      <p style="color: var(--muted);">
        <span data-lang="en">Loading...</span>
        <span data-lang="es">Cargando...</span>
      </p>
    </div>
  </section>

  <script>
    const BASE = document.body.getAttribute('data-base') || '/';

    // Language toggle
    function switchLang() {
      const html = document.documentElement;
      const isEn = html.lang === 'en';
      html.lang = isEn ? 'es' : 'en';
      const label = isEn ? 'EN' : 'ES';
      document.querySelectorAll('#lang-toggle, #lang-toggle-mobile').forEach(b => b.textContent = label);
    }
    document.getElementById('lang-toggle')?.addEventListener('click', switchLang);
    document.getElementById('lang-toggle-mobile')?.addEventListener('click', switchLang);

    // Tab switching
    const tabFlyers = document.getElementById('tab-flyers');
    const tabAlbums = document.getElementById('tab-albums');
    const flyersSection = document.getElementById('flyers-section');
    const albumsSection = document.getElementById('albums-section');

    function setTab(active) {
      const isFlyers = active === 'flyers';
      flyersSection.style.display = isFlyers ? '' : 'none';
      albumsSection.style.display = isFlyers ? 'none' : '';
      tabFlyers.style.background = isFlyers ? 'var(--accent)' : 'rgba(252,249,242,0.1)';
      tabFlyers.style.color = isFlyers ? 'var(--accent-ink)' : 'var(--sky)';
      tabAlbums.style.background = isFlyers ? 'rgba(252,249,242,0.1)' : 'var(--accent)';
      tabAlbums.style.color = isFlyers ? 'var(--sky)' : 'var(--accent-ink)';
    }
    tabFlyers?.addEventListener('click', () => setTab('flyers'));
    tabAlbums?.addEventListener('click', () => setTab('albums'));

    // Flyers
    (async () => {
      const currentEl = document.getElementById('flyers-current');
      const archiveEl = document.getElementById('flyers-archive');
      try {
        const res = await fetch(BASE + 'content/flyers.json');
        const flyers = await res.json();
        if (!flyers.length) {
          currentEl.innerHTML = `<p style="color: var(--muted);"><span data-lang="en">No flyers this week.</span><span data-lang="es">No hay volantes esta semana.</span></p>`;
          archiveEl.innerHTML = `<p style="color: var(--muted);"><span data-lang="en">No archived flyers.</span><span data-lang="es">No hay volantes archivados.</span></p>`;
          return;
        }
        const now = new Date();
        const weekAgo = new Date(now - 7 * 24 * 60 * 60 * 1000);
        const current = flyers.filter(f => new Date(f.date) >= weekAgo);
        const archive = flyers.filter(f => new Date(f.date) < weekAgo);

        function renderFlyers(items) {
          if (!items.length) return `<p style="color: var(--muted);"><span data-lang="en">None.</span><span data-lang="es">Ninguno.</span></p>`;
          return `<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px;">` +
            items.map(f => `<a href="${BASE}content/flyers/${f.file}" target="_blank" rel="noopener" style="display: block; background: var(--field-la); overflow: hidden; text-decoration: none;">
              <img src="${BASE}content/flyers/${f.file}" alt="${f.title}" style="width: 100%; aspect-ratio: 8.5/11; object-fit: cover;" loading="lazy" />
              <div style="padding: 12px 16px;">
                <p style="font-weight: 500; color: var(--ink);">${f.title}</p>
                <p style="font-size: var(--step-small); color: var(--muted); margin-top: 4px;">${new Date(f.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
              </div>
            </a>`).join('') + `</div>`;
        }

        currentEl.innerHTML = renderFlyers(current);
        archiveEl.innerHTML = renderFlyers(archive);
      } catch { currentEl.innerHTML = '<p style="color: var(--muted);">Could not load flyers.</p>'; }

      if (document.documentElement.lang === 'es') {
        document.querySelectorAll('[data-lang="en"]').forEach(e => e.style.display = 'none');
        document.querySelectorAll('[data-lang="es"]').forEach(e => e.style.display = '');
      }
    })();

    // Photo Albums
    (async () => {
      const container = document.getElementById('albums-container');
      try {
        const res = await fetch(BASE + 'content/photos.json');
        const albums = await res.json();
        if (!albums.length || !albums.some(a => a.photos.length)) {
          container.innerHTML = `<p style="color: var(--muted);"><span data-lang="en">No photo albums yet.</span><span data-lang="es">No hay álbumes de fotos aún.</span></p>`;
          return;
        }

        let html = '';
        albums.forEach(album => {
          if (!album.photos.length) return;
          const folder = encodeURIComponent(album.folder);
          html += `<div style="margin-bottom: 48px;">
            <h2 class="font-semibold" style="font-size: var(--step-lead); color: var(--ink); margin-bottom: 16px;">${album.album}</h2>
            <p style="font-size: var(--step-small); color: var(--muted); margin-bottom: 16px;">${album.photos.length} photos</p>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px;">
              ${album.photos.map(p => `<a href="${BASE}content/photos/${folder}/${encodeURIComponent(p)}" target="_blank" style="display: block; aspect-ratio: 1; overflow: hidden;">
                <img src="${BASE}content/photos/${folder}/${encodeURIComponent(p)}" alt="${album.album}" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
              </a>`).join('')}
            </div>
          </div>`;
        });

        container.innerHTML = html || `<p style="color: var(--muted);">No photos yet.</p>`;
      } catch { container.innerHTML = '<p style="color: var(--muted);">Could not load albums.</p>'; }

      if (document.documentElement.lang === 'es') {
        container.querySelectorAll('[data-lang="en"]').forEach(e => e.style.display = 'none');
        container.querySelectorAll('[data-lang="es"]').forEach(e => e.style.display = '');
      }
    })();
  </script>
</body>
</html>
