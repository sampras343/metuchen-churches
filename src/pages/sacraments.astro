---
import '../styles/global.css';
import { t } from '../lib/i18n';
import data from '../data/churches.json';
const base = import.meta.env.BASE_URL;
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sacraments — Most Holy Name of Jesus Parish</title>
  <link rel="icon" href={`${base}favicon.ico`} />
  <link rel="preconnect" href="https://api.fontshare.com" />
  <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
  <link href="https://api.fontshare.com/v2/css?f[]=chillax@400,500,600&display=swap" rel="stylesheet" />
</head>
<body>

  <nav class="fixed top-0 left-0 w-full z-50 flex items-center justify-between h-16" style="padding: 0 var(--margin); background: rgba(252,249,242,0.95);">
    <a href={base} class="flex items-center gap-2" style="color: var(--accent); font-size: var(--step-small); font-weight: 600; letter-spacing: -0.02em; text-decoration: none;">
      <img src={`${base}favicon.ico`} alt="" width="24" height="24" style="flex-shrink: 0;" />
      <Fragment set:html={t('nav.home')} />
    </a>
    <div class="hidden md:flex items-center gap-6">
      <a href={base} style="font-size: var(--step-small); color: var(--muted);"><Fragment set:html={t('nav.home')} /></a>
      <a href={`${base}sacraments`} style="font-size: var(--step-small); color: var(--accent); font-weight: 600;"><Fragment set:html={t('nav.sacraments')} /></a>
      <button id="lang-toggle" class="btn" style="padding: 6px 16px; font-size: var(--step-small);" aria-label="Switch language">ES</button>
    </div>
    <div class="flex md:hidden items-center gap-3">
      <button id="lang-toggle-mobile" class="btn" style="padding: 4px 12px; font-size: var(--step-small);" aria-label="Switch language">ES</button>
      <a href={base} style="font-size: var(--step-small); color: var(--muted); text-decoration: none;"><Fragment set:html={t('nav.home')} /></a>
    </div>
  </nav>

  <section style="padding: 100px var(--margin) 40px; background: var(--surface);">
    <h1 class="font-semibold" style="font-size: var(--step-head); letter-spacing: -0.03em; color: var(--cream);">
      <Fragment set:html={t('sacraments.title')} />
    </h1>
    <p style="margin-top: 8px; color: var(--sky);"><Fragment set:html={t('sacraments.subtitle')} /></p>

    <div class="flex gap-3 flex-wrap" style="margin-top: 32px;">
      <button class="sacrament-tab active" data-tab="baptism" style="padding: 10px 24px; font-size: var(--step-small); font-weight: 600; font-family: inherit; border: none; cursor: pointer; background: var(--accent); color: var(--accent-ink); transition: background 0.2s, color 0.2s;">
        <Fragment set:html={t('sacraments.baptism.title')} />
      </button>
      <button class="sacrament-tab" data-tab="confession" style="padding: 10px 24px; font-size: var(--step-small); font-weight: 600; font-family: inherit; border: none; cursor: pointer; background: rgba(252,249,242,0.1); color: var(--sky); transition: background 0.2s, color 0.2s;">
        <Fragment set:html={t('sacraments.confession.title')} />
      </button>
      <button class="sacrament-tab" data-tab="matrimony" style="padding: 10px 24px; font-size: var(--step-small); font-weight: 600; font-family: inherit; border: none; cursor: pointer; background: rgba(252,249,242,0.1); color: var(--sky); transition: background 0.2s, color 0.2s;">
        <Fragment set:html={t('sacraments.matrimony.title')} />
      </button>
    </div>
  </section>

  <section style="padding: clamp(40px, 6vw, 80px) var(--margin);">

    <!-- Baptism -->
    <div class="sacrament-panel active" data-panel="baptism">
      <h2 class="font-semibold" style="font-size: var(--step-lead); color: var(--ink); margin-bottom: 16px;">
        <Fragment set:html={t('sacraments.baptism.title')} />
      </h2>
      <div style="color: var(--muted); line-height: 1.8; max-width: 700px;">
        <p><Fragment set:html={t('sacraments.baptism.intro')} /></p>

        <a href={`${base}content/baptism-application.pdf`} download class="btn" style="display: inline-block; margin-top: 16px; margin-bottom: 32px; font-size: var(--step-small);">
          <Fragment set:html={t('sacraments.baptism.downloadBtn')} />
        </a>

        <h3 class="font-semibold" style="font-size: var(--step-body); color: var(--ink); margin-bottom: 12px;">
          <Fragment set:html={t('sacraments.baptism.reqTitle')} />
        </h3>
        <p><Fragment set:html={t('sacraments.baptism.reqWhen')} /></p>
        <p style="margin-top: 12px;"><Fragment set:html={t('sacraments.baptism.reqClasses')} /></p>

        <h3 class="font-semibold" style="font-size: var(--step-body); color: var(--ink); margin-top: 32px; margin-bottom: 12px;">
          <Fragment set:html={t('sacraments.baptism.gpTitle')} />
        </h3>
        <p><Fragment set:html={t('sacraments.baptism.gpIntro')} /></p>

        <ul style="margin-top: 12px; padding-left: 20px; list-style: disc;">
          {['gpReq1','gpReq2','gpReq3','gpReq4','gpReq5'].map(k => (
            <li style="padding: 4px 0;"><Fragment set:html={t(`sacraments.baptism.${k}`)} /></li>
          ))}
        </ul>

        <p style="margin-top: 16px;"><Fragment set:html={t('sacraments.baptism.gpLaw')} /></p>
        <p style="margin-top: 12px;"><Fragment set:html={t('sacraments.baptism.gpSponsor')} /></p>

        <p style="margin-top: 24px;">
          <span style="color: var(--accent); font-weight: 500;"><Fragment set:html={t('sacraments.contactLabel')} /></span>
          <a href="tel:+17324420512" style="color: var(--ink);">(732) 442-0512</a>
        </p>
      </div>
    </div>

    <!-- Confession -->
    <div class="sacrament-panel" data-panel="confession" style="display: none;">
      <h2 class="font-semibold" style="font-size: var(--step-lead); color: var(--ink); margin-bottom: 16px;">
        <Fragment set:html={t('sacraments.confession.title')} />
      </h2>
      <div style="color: var(--muted); line-height: 1.8; max-width: 700px;">
        <p><Fragment set:html={t('sacraments.confession.intro')} /></p>

        <div style="margin-top: 20px; display: flex; flex-direction: column; gap: 16px;">
          <div>
            <p style="color: var(--accent); font-weight: 600;"><Fragment set:html={t('sacraments.confession.sunday')} /></p>
            <p><Fragment set:html={t('sacraments.confession.sundayTime')} /></p>
          </div>
          <div>
            <p style="color: var(--accent); font-weight: 600;"><Fragment set:html={t('sacraments.confession.thursday')} /></p>
            <p><Fragment set:html={t('sacraments.confession.thursdayTime')} /></p>
          </div>
          <div>
            <p style="color: var(--accent); font-weight: 600;"><Fragment set:html={t('sacraments.confession.saturday')} /></p>
            <p><Fragment set:html={t('sacraments.confession.saturdayTime')} /></p>
          </div>
          <p style="margin-top: 8px; font-style: italic;"><Fragment set:html={t('sacraments.confession.byAppt')} /></p>
        </div>

        <p style="margin-top: 24px;">
          <span style="color: var(--accent); font-weight: 500;"><Fragment set:html={t('sacraments.contactLabel')} /></span>
          <a href="tel:+17324420512" style="color: var(--ink);">(732) 442-0512</a>
        </p>
      </div>
    </div>

    <!-- Matrimony -->
    <div class="sacrament-panel" data-panel="matrimony" style="display: none;">
      <h2 class="font-semibold" style="font-size: var(--step-lead); color: var(--ink); margin-bottom: 16px;">
        <Fragment set:html={t('sacraments.matrimony.title')} />
      </h2>
      <div style="color: var(--muted); line-height: 1.8; max-width: 700px;">
        <p><Fragment set:html={t('sacraments.matrimony.body')} /></p>
        <p style="margin-top: 24px;">
          <span style="color: var(--accent); font-weight: 500;"><Fragment set:html={t('sacraments.contactLabel')} /></span>
          <a href="tel:+17324420512" style="color: var(--ink);">(732) 442-0512</a>
        </p>
      </div>
    </div>
  </section>

  <script>
    function switchLang() {
      const html = document.documentElement;
      const isEn = html.lang === 'en';
      html.lang = isEn ? 'es' : 'en';
      const label = isEn ? 'EN' : 'ES';
      document.querySelectorAll('#lang-toggle, #lang-toggle-mobile').forEach(b => b.textContent = label);
    }
    document.getElementById('lang-toggle')?.addEventListener('click', switchLang);
    document.getElementById('lang-toggle-mobile')?.addEventListener('click', switchLang);

    function showSacrament(id) {
      document.querySelectorAll('.sacrament-tab').forEach(t => {
        const active = t.getAttribute('data-tab') === id;
        t.classList.toggle('active', active);
        t.style.background = active ? 'var(--accent)' : 'rgba(252,249,242,0.1)';
        t.style.color = active ? 'var(--accent-ink)' : 'var(--sky)';
      });
      document.querySelectorAll('.sacrament-panel').forEach(p => {
        p.style.display = p.getAttribute('data-panel') === id ? '' : 'none';
      });
    }

    document.querySelectorAll('.sacrament-tab').forEach(t => {
      t.addEventListener('click', () => showSacrament(t.getAttribute('data-tab')));
    });

    const hash = window.location.hash.replace('#', '');
    if (hash && ['baptism', 'confession', 'matrimony'].includes(hash)) {
      showSacrament(hash);
    }
  </script>
</body>
</html>
